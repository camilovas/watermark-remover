FROM python:3.11-slim

WORKDIR /app

# Librerías de sistema requeridas por Qt/PySide6, aunque corra sin pantalla (offscreen).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libegl1 \
    libxkbcommon0 \
    libdbus-1-3 \
    libfontconfig1 \
    libx11-xcb1 \
    libxcb-cursor0 \
    libxrandr2 \
    libxi6 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libnss3 \
    libxrender1 \
    && rm -rf /var/lib/apt/lists/*

ENV QT_QPA_PLATFORM=offscreen
ENV PYTHONPATH=/app/src

COPY docker/requirements-test.txt ./
RUN pip install --no-cache-dir -r requirements-test.txt

COPY src ./src
COPY tests ./tests

CMD ["pytest", "-v"]
